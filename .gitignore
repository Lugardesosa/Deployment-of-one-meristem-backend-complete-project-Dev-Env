# =====================================================
# Git Ignore File for One Meristem App
# =====================================================

# OS files
.DS_Store

# Temporary files
*.log
*.tmp
*.bak
*.swp
*.old
*.orig
*.rej

# Compiled files
*.class
*.pyc
*.pyo
*.exe
*.dll
*.so

# Environment files
.env.local

# GitHub workflows (ignore test_env workflows)
# .github/workflows/*

# =====================================================
# Server-specific folders (NOT tracked in Git)
# =====================================================
gcme/
certs/
data/
html/
logs_collector/
monitoring/
onemeristemdev.meristemng.com/
user-service/
vhost/

# =====================================================
# Security keys (server-specific, never commit!)
# =====================================================
backend/users-service/src/main/resources/keys/
backend/notification-service/src/main/resources/keys/
backend/wallet-service/src/main/resources/keys/
backend/trustees-service/src/main/resources/keys/
backend/wealth-services/src/main/resources/keys/
backend/report-service/src/main/resources/keys/
backend/cloud-gateway/src/main/resources/keys/
backend/config-server/src/main/resources/keys/

# Generic key patterns
*.pem
*.key
*.crt
*.jks
*.p12
*.keystore
